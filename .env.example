MEDIA_HOST_PATH=/Users/alex/Media
# Co-located catalog inside the media volume (recommended).
# For a catalog on a separate fast disk, mount it and set APP_DATA_DIR accordingly.
MEDIA_ROOT=/media
APP_DATA_DIR=/media/.imageOrganizer

# Optional: second disk for Settings → Copy library / Update backup (mounted at /media-backup).
# Set this, then: docker compose up -d --force-recreate backend
# After cutover: set MEDIA_HOST_PATH to the new host path; keep BACKUP_MEDIA_HOST_PATH on the old disk for Update backup.
# BACKUP_MEDIA_HOST_PATH=/Users/alex/Media
